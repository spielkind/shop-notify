# Caddy in front of Shop Notify's web UI (COMPOSE_PROFILES=caddy in .env): HTTPS with a
# certificate from Let's Encrypt for UI_DOMAIN, renewed automatically - see docs/web-ui.md.
# UI_DOMAIN must point to this server, and ports 80 and 443 must be reachable.
{
	acme_ca {$ACME_CA}
	# 80 and 443 unless set otherwise (the end-to-end test uses other ports)
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	# Optional: an address for Let's Encrypt's account (it sends no expiry mails anymore)
	# email you@example.com
}

{$UI_DOMAIN} {
	encode zstd gzip
	# Passes the host and the client address (X-Forwarded-For) on to the UI, which sets
	# its own security headers
	reverse_proxy {$UI_UPSTREAM:ui:3000}
	header -Server
	log
}
