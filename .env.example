# Etsy Open API v3 – https://www.etsy.com/developers/your-apps
ETSY_API_KEY="your-keystring"
ETSY_SHARED_SECRET="your-shared-secret"
# Either the shop name (as in etsy.com/shop/<name>) or its numeric ID
ETSY_SHOP_NAME="YourShopName"
# ETSY_SHOP_ID=12345678
# ETSY_API_ENDPOINT="https://openapi.etsy.com/v3/application/"

# POLL_INTERVAL=300
# Hours a notified item must be gone from the shop before it is forgotten (and notified
# again if it comes back); protects against short gaps in Etsy's listing index
# FORGET_AFTER_HOURS=24
# Events to notify (docs/events.md): new, back, restocked, price_drop, price_rise,
# sold_out, low_stock
# NOTIFY_EVENTS=new,back
# NOTIFY_PRICE_CHANGE_PERCENT=5
# NOTIFY_LOW_STOCK=1
# Days the poll log is kept (shop-notify history --polls)
# POLL_HISTORY_DAYS=14
# DB_PATH=shop-notify.db
# HEARTBEAT_FILE=shop-notify.heartbeat
# LOG_FILE=shop-notify.log
# LOG_LEVEL=INFO

# Notification targets (Apprise). Without any, new items are only printed to the console.
# Recommended: a config file with one entry per target, see notify.example.yml
# NOTIFY_CONFIG=notify.yml
# Short form for simple setups: one or more Apprise URLs, separated by spaces or commas
# NOTIFY_URLS="ntfys://ntfy.sh/your-random-topic"
# Console output: auto (only without other targets) | true (always) | false (never)
# NOTIFY_CONSOLE=auto
# Also send the items already in the shop on the first run (empty database)
# NOTIFY_EXISTING_ON_FIRST_RUN=false
# Directory with custom message templates (subject.txt.j2, body.txt.j2, body.html.j2)
# Language of the built-in messages: en | de
# NOTIFY_LANGUAGE=en
# Push/chat services: one message per new item with its picture, up to NOTIFY_IMAGES_MAX items
# NOTIFY_IMAGES=true
# NOTIFY_IMAGES_MAX=5
# Above that: attach the pictures to the summary (Telegram album with ?album=yes in the URL)
# NOTIFY_IMAGES_IN_SUMMARY=false
# NOTIFY_TEMPLATE_DIR=templates

# Optional local-time scheduling (off by default); see docs/notifications.md.
# Quiet hours gate all targets, including untagged and console targets.
# NOTIFY_QUIET_HOURS=22:00-07:00
# Apprise tags identify digest groups; untagged targets stay immediate.
# Each service may have at most one configured digest-group tag.
# NOTIFY_DIGEST=family:daily,oma:weekly
# NOTIFY_DIGEST_TIME=08:00
# NOTIFY_DIGEST_DAY=mon

# Filters (see docs/filters.md): skip or select items by title or price.
# Keywords are comma-separated; each regex is one pattern - put it in SINGLE quotes.
# NOTIFY_EXCLUDE=gift card, custom order
# NOTIFY_INCLUDE=mug, vase
# NOTIFY_EXCLUDE_REGEX='^reserved\b'
# NOTIFY_INCLUDE_REGEX='\bmini (art )?print\b'
# NOTIFY_MIN_PRICE=10
# NOTIFY_MAX_PRICE=150
# Any number of rules in a YAML file (see filters.example.yml)
# FILTER_CONFIG=filters.yml

# Time zone for quiet hours, digests, notification dates and logs inside Docker
# (locally and with systemd the system time zone is used)
# TZ=Europe/Berlin

# Optional web UI of the history (docs/web-ui.md) with Docker Compose:
#   caddy = UI with HTTPS from Let's Encrypt by Caddy (ports 80 and 443)
#   ui    = UI on 127.0.0.1:UI_PORT, for your own nginx or Apache in front
# COMPOSE_PROFILES=caddy
# Host name of the UI; it must point to this server (no default on purpose)
# UI_DOMAIN=shop.example.com
# UI_PORT=3000
# Days a sign-in is valid, and the language of the UI
# UI_SESSION_DAYS=30
# UI_LANGUAGE=en
# Number of reverse proxies in front of the UI that add to X-Forwarded-For
# UI_PROXY_DEPTH=1
# Let's Encrypt's staging environment while trying it out (certificates aren't trusted)
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
