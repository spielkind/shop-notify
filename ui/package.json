{
	"name": "shop-notify-ui",
	"private": true,
	"version": "1.5.0",
	"description": "Web UI for the history recorded by Shop Notify",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24.11"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"api-types": "json2ts --input ../docs/api.schema.json --output src/lib/api-types.ts --unreachableDefinitions --additionalProperties false --bannerComment \"// Generated from docs/api.schema.json by 'npm run api-types' - don't edit\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run --coverage",
		"cli": "node src/lib/server/cli.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"json-schema-to-typescript": "^16.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
