{
	"name": "shop-notify-ui",
	"private": true,
	"version": "1.8.1",
	"description": "Web UI for the history recorded by Shop Notify",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"api-types": "json2ts --input ../docs/schema/api.schema.json --output src/lib/api-types.ts --unreachableDefinitions --additionalProperties false --bannerComment \"// Generated from docs/schema/api.schema.json by 'npm run api-types' - don't edit\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run --coverage",
		"cli": "node src/lib/server/cli.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"json-schema-to-typescript": "^16.0.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"minimatch": "^11.0.1"
	}
}
