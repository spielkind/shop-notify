{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"],
		// The server modules also run directly with Node (shop-notify-ui), which strips
		// the types: only erasable syntax, and imports with their .ts extension
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src", "vite.config.ts"]
}
