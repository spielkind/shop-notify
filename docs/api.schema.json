{
  "$defs": {
    "Error": {
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "title": "Error",
      "type": "object"
    },
    "Event": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "listing_id": {
          "type": "integer"
        },
        "time": {
          "format": "date-time",
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "listing_id",
        "time",
        "event",
        "details",
        "title"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventPage": {
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "next": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "events",
        "next"
      ],
      "title": "EventPage",
      "type": "object"
    },
    "Health": {
      "properties": {
        "status": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "schema_version": {
          "type": "integer"
        },
        "last_poll": {
          "anyOf": [
            {
              "$ref": "#/$defs/Poll"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "status",
        "version",
        "schema_version",
        "last_poll"
      ],
      "title": "Health",
      "type": "object"
    },
    "Listing": {
      "description": "Subset of an Etsy v3 ShopListing; only these fields are stored locally.",
      "properties": {
        "listing_id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "last_modified_timestamp": {
          "type": "integer"
        },
        "state_timestamp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_timestamp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "original_creation_timestamp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "listing_id",
        "title",
        "url",
        "last_modified_timestamp"
      ],
      "title": "Listing",
      "type": "object"
    },
    "ListingDetail": {
      "properties": {
        "listing": {
          "$ref": "#/$defs/StoredListing"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "listing",
        "events"
      ],
      "title": "ListingDetail",
      "type": "object"
    },
    "Money": {
      "properties": {
        "amount": {
          "type": "integer"
        },
        "divisor": {
          "type": "integer"
        },
        "currency_code": {
          "type": "string"
        }
      },
      "required": [
        "amount",
        "divisor",
        "currency_code"
      ],
      "title": "Money",
      "type": "object"
    },
    "Poll": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "time": {
          "format": "date-time",
          "type": "string"
        },
        "reported": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "received": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "new": {
          "type": "integer"
        },
        "back": {
          "type": "integer"
        },
        "missing": {
          "type": "integer"
        },
        "gone": {
          "type": "integer"
        },
        "filtered": {
          "type": "integer"
        },
        "restocked": {
          "type": "integer"
        },
        "sold_out": {
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "time",
        "reported",
        "received",
        "complete",
        "new",
        "back",
        "missing",
        "gone",
        "filtered",
        "restocked",
        "sold_out",
        "error"
      ],
      "title": "Poll",
      "type": "object"
    },
    "PollPage": {
      "properties": {
        "polls": {
          "items": {
            "$ref": "#/$defs/Poll"
          },
          "type": "array"
        },
        "next": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "polls",
        "next"
      ],
      "title": "PollPage",
      "type": "object"
    },
    "StoredListing": {
      "description": "The latest state of a listing as recorded in the database.",
      "properties": {
        "listing": {
          "$ref": "#/$defs/Listing"
        },
        "status": {
          "type": "string"
        },
        "first_seen": {
          "format": "date-time",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "type": "string"
        },
        "missing_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "gone_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sold_out_since": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notified": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "filtered": {
          "type": "boolean"
        },
        "pending": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "listing",
        "status",
        "first_seen",
        "last_seen",
        "missing_since",
        "gone_since",
        "sold_out_since",
        "notified",
        "filtered",
        "pending"
      ],
      "title": "StoredListing",
      "type": "object"
    }
  },
  "title": "Shop Notify API",
  "description": "Responses of the read-only API, schema version 3"
}
